---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Projects";
const projects = (await getCollection("projects"))
  .sort((a, b) =>
    (b.data.pinned ? 1 : 0) - (a.data.pinned ? 1 : 0) ||
    b.data.date.valueOf() - a.data.date.valueOf()
  );
---

<BaseLayout pageTitle={pageTitle} description="Projects by Will Lotherington.">
  <h1>Projects</h1>
  <ul class="project-list">
    {projects.map((project) => (
      <li>
        <a href={`/projects/${project.id}/`}>{project.data.title}</a>
        <span class="muted year">{project.data.date.getUTCFullYear()}</span>
        {project.data.wip && <span class="wip-badge">WIP</span>}
        {project.data.pinned && (
          <svg class="pin-icon" viewBox="0 0 16 16" width="14" height="14" role="img" aria-label="Pinned">
            <title>Pinned</title>
            <path fill="currentColor" d="m11.294.984 3.722 3.722a1.75 1.75 0 0 1-.663 2.888l-1.928.643a3.75 3.75 0 0 0-2.288 2.288l-.643 1.928a1.75 1.75 0 0 1-2.888.663L4.75 12.06l-3.72 3.72a.748.748 0 0 1-1.265-.332.75.75 0 0 1 .205-.729l3.72-3.72-1.853-1.853a1.75 1.75 0 0 1 .663-2.888l1.928-.643a3.75 3.75 0 0 0 2.288-2.288l.643-1.928a1.75 1.75 0 0 1 2.888-.663Z"/>
          </svg>
        )}
        <p class="muted">{project.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }

  .project-list li {
    margin-bottom: 1.625rem;
  }

  .project-list > li > a {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 580;
    letter-spacing: -0.005em;
    color: var(--color-text);
    text-decoration: none;
  }

  .project-list > li > a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .project-list p {
    margin: 0.1875rem 0 0;
  }

  .year {
    margin-left: 0.625rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .pin-icon {
    margin-left: 0.375rem;
    color: var(--color-muted);
    vertical-align: -0.0625rem;
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const allProjects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pinned = allProjects.find((project) => project.data.pinned);
const otherProjects = allProjects.filter((project) => !project.data.pinned);
---

<BaseLayout description="Will Lotherington, senior software engineer. Writing and projects.">
  <h1 class="hero-title">Hi, I'm Will.</h1>
  <p class="hero-intro">
    I'm a senior software engineer at Google. This site is where I keep my
    writing and the projects I build on the side.
  </p>

  <h2 class="section-label">Projects</h2>
  {pinned && (
    <section class="pinned">
      <h3><a href={`/projects/${pinned.id}/`}>{pinned.data.title}</a></h3>
      <p class="pinned-description">{pinned.data.description}</p>
      {pinned.data.video && (
        <iframe class="video-embed pinned-video" loading="lazy" src={pinned.data.video} title={`${pinned.data.title} talk video`} allowfullscreen></iframe>
      )}
      <p class="pinned-links">
        <a href={`/projects/${pinned.id}/`}>Read more</a>
        {pinned.data.link && <> · <a href={pinned.data.link}>{pinned.data.linkLabel}</a></>}
        {pinned.data.repo && <> · <a href={pinned.data.repo}>Source</a></>}
      </p>
    </section>
  )}
  <ul class="home-project-list">
    {otherProjects.map((project) => (
      <li>
        <a href={`/projects/${project.id}/`}>{project.data.title}</a>
        {project.data.wip && <span class="wip-badge">WIP</span>}
        <p class="muted">{project.data.description}</p>
      </li>
    ))}
  </ul>

  <h2 class="section-label">Recent writing</h2>
  <ul class="item-list">
    {posts.map((post) => (
      <BlogPost url={`/posts/${post.id}/`} title={post.data.title} date={post.data.pubDate} />
    ))}
  </ul>
  <p class="all-posts"><a href="/blog/">All posts →</a></p>
</BaseLayout>

<style>
  .hero-title {
    font-size: 2.875rem;
    margin: 1rem 0 1.25rem;
  }

  .hero-intro {
    font-size: 1.1875rem;
    line-height: 1.6;
    max-width: 34rem;
    margin: 0 0 1rem;
  }

  .pinned {
    margin: 0 0 1.5rem;
    padding: 1.375rem 1.5rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-faint);
    border-radius: 10px;
  }

  .pinned h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.375rem;
  }

  .pinned h3 a {
    color: inherit;
    text-decoration: none;
  }

  .pinned h3 a:hover {
    color: var(--color-accent);
  }

  .pinned-description {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
  }

  .pinned-video {
    margin-bottom: 0.875rem;
  }

  .pinned-links {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .home-project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .home-project-list li {
    margin-bottom: 1.25rem;
  }

  .home-project-list > li > a {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    color: var(--color-text);
    text-decoration: none;
  }

  .home-project-list > li > a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .home-project-list p {
    margin: 0.125rem 0 0;
  }

  .all-posts {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }
</style>

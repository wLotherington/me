---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import me from "../assets/me.jpg";
const pageTitle = "About";
---

<BaseLayout pageTitle={pageTitle} description="About Will Lotherington.">
  <h1>About</h1>

  <div class="about-intro">
    <div>
      <p>
        I'm Will Lotherington. I strive to be a better learner, and I believe
        that consistent deliberate practice is paramount.
      </p>
      <p>
        Currently, I'm a senior software engineer at Google. Previously I've
        been a marketing analyst, an industrial automation application
        engineer, a machine vision sales engineer, and a
        photographer/videographer.
      </p>
    </div>
    <Image class="portrait" src={me} alt="Will Lotherington" width={140} densities={[1, 2]} />
  </div>

  <p>
    You can find me on <a href="https://github.com/wLotherington">GitHub</a> or <a href="https://www.linkedin.com/in/wlotherington/">LinkedIn</a>, or shoot me an email at <a href="mailto:will@lotherington.me">will@lotherington.me</a>.
  </p>
</BaseLayout>

<style>
  .about-intro {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 0.5rem;
  }

  .about-intro > div {
    flex: 1;
  }

  .portrait {
    flex-shrink: 0;
    border-radius: 8px;
  }

  @media (max-width: 480px) {
    .about-intro {
      flex-direction: column-reverse;
    }
  }
</style>

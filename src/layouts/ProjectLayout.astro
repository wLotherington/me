---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <article>
    <header class="article-header">
      <p class="article-eyebrow">
        {frontmatter.date.getUTCFullYear()}{frontmatter.wip && <span class="wip-badge">WIP</span>}
      </p>
      <h1>{frontmatter.title}</h1>
      <p class="article-subtitle">{frontmatter.description}</p>
      {(frontmatter.repo || frontmatter.link) && (
        <p class="article-links">
          {frontmatter.link && <a href={frontmatter.link}>{frontmatter.linkLabel}</a>}
          {frontmatter.link && frontmatter.repo && ' · '}
          {frontmatter.repo && <a href={frontmatter.repo}>Source</a>}
        </p>
      )}
    </header>

    <slot />
  </article>
</BaseLayout>

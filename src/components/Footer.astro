---
const year = new Date().getFullYear();
---

<footer>
  <p>© {year} Will Lotherington</p>
  <p class="footer-links">
    <a href="https://github.com/wLotherington">GitHub</a>
    <a href="https://www.linkedin.com/in/wlotherington/">LinkedIn</a>
    <a href="/rss.xml">RSS</a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-faint);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
